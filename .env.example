# Copy to .env.local for local work. Never commit real secrets.

# preview | production — production builds refuse demo data.
APP_ENV=preview

# demo  = local placeholder records (marked "demo data" in the UI)
# empty = no operational data (shows what the site looks like before approval)
# amplify = Amplify Data backend (Phase 2)
DATA_SOURCE=demo

# Public site origin, used for canonical/hreflang URLs. Required in production (https).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
